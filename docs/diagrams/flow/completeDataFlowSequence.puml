@startuml GITGLE End-to-End Data Flow
title GITGLE: Complete Data Flow from Initialization to Search Results

participant "User" as user
participant "Crawl Pipeline" as crawlPip
participant "Recursive Crawl" as recurse
participant "Repo Fetcher" as fetcher
participant "GitHub API" as github
participant "Index Pipeline" as indexPip
participant "MapReduce" as mr
participant "Store" as store
participant "Search Pipeline" as searchPip
participant "Query Parser" as parser
participant "Search Service" as search

user -> crawlPip: runCrawl(seedFile)
note right of crawlPip
  INITIALIZATION:
  Load seed repositories
end note

crawlPip -> recurse: runRecursiveCrawl()
note right of recurse
  CRAWL PHASE
  Frontier-based sequential crawling
  Process one repo at a time
end note

recurse -> fetcher: fetchRepoData(owner, repo)
fetcher -> github: GET /repos/{owner}/{repo}
github --> fetcher: metadata, readme, stars
fetcher --> recurse: repoData

recurse -> store: PUT metadata

user -> indexPip: runIndex()
note right of indexPip
  INDEX PHASE
  Build inverted index via MapReduce
end note

indexPip -> store: GET all documents
indexPip -> mr: exec(map, reduce, docs)

mr -> mr: MAP: tokenize, count TF
note right of mr
  Map phase on 3 nodes:
  - tokenize text
  - lowercase & normalize
  - count term frequencies
  - emit (term, {docId: freq})
end note

mr -> mr: SHUFFLE: group by term
note right of mr
  Shuffle phase:
  - collect identical terms
  - distribute to reducers
  - via consistent hash
end note

mr -> mr: REDUCE: aggregate postings
note right of mr
  Reduce phase:
  - collect all occurrences
  - aggregate postings
  - calculate document frequency
  - store inverted index
end note

mr -> store: PUT inv:full-index
mr -> store: PUT stats:index

user -> searchPip: executeSearch(query)
note right of searchPip
  SEARCH PHASE
  Execute query and rank results
end note

searchPip -> parser: parse(query string)
note right of parser
  Query Parser:
  - tokenize query
  - normalize terms
  - prepare for lookup
end note

searchPip -> search: search(terms)
search -> store: GET postings(term)
note right of search
  For each candidate document:
  - lookup term postings
  - get term frequency (TF)
  - get document frequency (DF)
  - calculate: TF-IDF = TF * log(N/DF)
  - apply metadata boost
  - final score = TF-IDF * boost
end note

search -> store: GET metadata(docId)
note right of search
  Metadata boost:
  - language: 1.3x for programming languages
  - stars: 1.2x to 2.0x based on popularity
end note

search --> searchPip: results[]
searchPip --> user: Display top results

note over crawlPip
  Crawl: Sequential frontier processing
  Real GitHub API calls with retry logic
  ~86 seed repositories, up to max repos
end note

note over mr
  Index: Parallel distributed MapReduce
  3 worker nodes process documents
  Result: ~4400 unique terms indexed
end note

note over search
  Search: KV store lookup + ranking
  TF-IDF with metadata boosts
  Return top 10 ranked results
end note

@enduml
