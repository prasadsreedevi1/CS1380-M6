@startuml GITGLE MapReduce Execution
title GITGLE: MapReduce Execution - Crawl & Index Phases

rectangle "CRAWL PHASE" {
  rectangle "INPUT: Seed Repos" {
    note
      github-repos.txt
    end note
  }
  rectangle "MAP: Fetch Metadata" {
    note
      3 workers
      Fetch data
      Download README
    end note
  }
  rectangle "SHUFFLE" {
    note
      Group by hash
      Distribute
    end note
  }
  rectangle "REDUCE: Store" {
    note
      3 reducers
      Store in KV
    end note
  }
}

rectangle "INDEX PHASE" {
  rectangle "INPUT: Documents" {
    note
      Extract README
    end note
  }
  rectangle "MAP: Tokenize" {
    note
      3 workers
      Tokenize text
      Count frequencies
    end note
  }
  rectangle "SHUFFLE" {
    note
      Group by term
      Hash distribution
    end note
  }
  rectangle "REDUCE: Index" {
    note
      3 reducers
      Build inverted index
      Calculate DF
    end note
  }
}

@enduml
