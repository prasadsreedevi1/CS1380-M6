@startuml M6-System-Architecture

' Complete end-to-end system architecture showing all three phases
' Phase 1: CRAWL - fetch repos from GitHub and seeds
' Phase 2: INDEX - process documents, build inverted index, calculate TF-IDF
' Phase 3: SEARCH - parse query, lookup index, rank results
' Shows data flow from GitHub API to CLI output, all M1-M5 components integrated

!define BGCOLOR #F5F5F5
!define ACCENTCOLOR #1F77B4
!define ACCENTCOLOR2 #FF7F0E
!define ACCENTCOLOR3 #2CA02C

skinparam backgroundColor BGCOLOR
skinparam componentFontColor #333
skinparam ArrowColor #666

title M6 Distributed Search Engine - System Architecture

package "External Services" {
  component [GitHub API] as GITHUB
  component [Seed Repository] as SEEDS
}

package "Presentation Layer" {
  component [Search CLI] as CLI
  component [Result Formatter] as FORMATTER
}

package "Core Search Pipeline" {
  component [Crawl Pipeline] as CRAWL_PIPE
  component [Index Pipeline] as INDEX_PIPE
  component [Search Pipeline] as SEARCH_PIPE
}

package "Search Services" {
  component [Document Processor] as DOC_PROC
  component [Query Processor] as QUERY_PROC
  component [Search Service] as SEARCH_SVC
}

package "Search Components" {
  package "Text Processing" {
    component [Extract README] as EXTRACT
    component [Normalize Text] as NORMALIZE
    component [Tokenize] as TOKENIZE
    component [Stem] as STEM
    component [N-Grams] as NGRAMS
  }
  
  package "Ranking" {
    component [TF-IDF] as TFIDF
    component [Metadata Boost] as METADATA
    component [Score Calculator] as SCORE
  }
  
  package "Query" {
    component [Query Parser] as QPARSER
    component [Query Processor] as QPROC
  }
  
  package "Data Models" {
    component [RepoDocument] as REPODOC
    component [IndexEntry] as INDEXENTRY
    component [SearchResult] as SEARCHRESULT
  }
}

package "Storage & Indexing" {
  component [Inverted Index] as INVERTED
  component [TF Index] as TFINDEX
  component [DF Index] as DFINDEX
  component [M4 Distributed Store] as M4STORE
}

package "Distributed Runtime" {
  component [M1: Serialization] as M1
  component [M2: Local Communication] as M2
  component [M3: Gossip Protocol] as M3
  component [M4: Key-Value Store] as M4
  component [M5: MapReduce] as M5
}

SEEDS --> CRAWL_PIPE: Repository list
GITHUB --> CRAWL_PIPE: Repository metadata\n& READMEs
CRAWL_PIPE --> INDEX_PIPE: Documents
INDEX_PIPE --> INVERTED: Inverted index\n& statistics

EXTRACT --> NORMALIZE: Raw README
NORMALIZE --> TOKENIZE: Clean text
TOKENIZE --> STEM: Tokens
STEM --> NGRAMS: Stemmed terms
NGRAMS --> DOC_PROC: N-grams

DOC_PROC --> TFIDF: Document terms\n& frequencies
TFIDF --> METADATA: TF values
METADATA --> SCORE: Boost factors
SCORE --> INDEXENTRY: Scored tokens

TFIDF --> DFINDEX: Document frequency
METADATA --> TFINDEX: Term frequency

INVERTED --> M4STORE: Index distribution
TFINDEX --> M4STORE: TF data
DFINDEX --> M4STORE: DF data

CLI --> SEARCH_PIPE: Query string
SEARCH_PIPE --> QPARSER: User query
QPARSER --> QPROC: Parsed query
QPROC --> SEARCH_SVC: Processed terms

SEARCH_SVC --> M4STORE: Lookup index
M4STORE --> SEARCH_SVC: Matching documents
SEARCH_SVC --> SEARCHRESULT: Ranked results

SEARCHRESULT --> FORMATTER: Results
FORMATTER --> CLI: Formatted output

M4 -.-> M1: Serialization
M4 -.-> M2: Local communication
M4 -.-> M3: Gossip protocol
M5 -.-> M4: Uses M4 store

note right of CRAWL_PIPE
  Phase 1: Fetch & parse
  repository seeds
  Distributed via M5
end note

note right of INDEX_PIPE
  Phase 2: Process documents
  Build inverted index
  Distributed via M5
end note

note right of SEARCH_PIPE
  Phase 3: Parse & execute
  queries on index
  Distributed via M4
end note

note right of M4STORE
  Persistent storage for:
  - Inverted index
  - TF/DF statistics
  - Document metadata
end note

@enduml
