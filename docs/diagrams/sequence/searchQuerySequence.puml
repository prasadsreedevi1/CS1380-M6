@startuml M6-Search-Sequence

' Query processing sequence: parse -> process -> search -> rank -> format
' Shows 10 steps from user input to final results display
' Demonstrates TF-IDF calculation with real example: fibonacci = 0.05 TF, 1.301 IDF
' Shows metadata boost calculation (language, stars, topics)
' Final score combines: 0.75 × TF-IDF + 0.25 × metadata boost

!define BGCOLOR #F5F5F5
skinparam backgroundColor BGCOLOR
skinparam sequenceFontColor #333
skinparam participantBorderColor #333
skinparam ArrowColor #333
skinparam shadowing false

title M6 Search Engine - Query Processing Sequence

actor "User" as USER
participant "Search CLI" as CLI
participant "Search Pipeline" as PIPE
participant "Query Parser" as PARSER
participant "Query Processor" as PROC
participant "Index Lookup" as INDEX
participant "TF-IDF Scorer" as SCORER
participant "Metadata Booster" as BOOST
participant "Results Ranker" as RANK
participant "Result Formatter" as FMT
participant "KV Store" as STORE

USER -> CLI: npm run search "javascript framework"

CLI -> PIPE: executeSearch(query, options)
activate PIPE

PIPE -> PARSER: parseQuery("javascript framework")
activate PARSER
PARSER -> PARSER: extractTerms() -> ["javascript", "framework"]
PARSER -> PARSER: extractFilters() -> {lang: undefined, owner: undefined}
PARSER -> PARSER: normalizeTerms() -> ["javascript", "framework"]
PARSER --> PIPE: {terms, filters}
deactivate PARSER

PIPE -> PROC: processQuery(parsed)
activate PROC
PROC -> PROC: tokenize(query)
PROC -> PROC: normalize(tokens)
PROC -> PROC: stem(tokens) -> ["javascript", "framework"]
PROC --> PIPE: processedTerms
deactivate PROC

PIPE -> STORE: getPostings("javascript")
activate STORE
STORE --> PIPE: [(docId1, tf1), (docId2, tf2), ...]
deactivate STORE

PIPE -> STORE: getPostings("framework")
STORE --> PIPE: [(docId3, tf3), (docId4, tf4), ...]

PIPE -> INDEX: findIntersection(postings)
activate INDEX
INDEX -> INDEX: merge candidate documents
INDEX --> PIPE: candidateDocs
deactivate INDEX

loop For each candidate document
  PIPE -> STORE: getTFStats(docId, term)
  PIPE -> STORE: getDFStats(term)
  
  PIPE -> SCORER: calculateTFIDF(tf, df, docLength)
  activate SCORER
  SCORER -> SCORER: tf = count / docLength
  SCORER -> SCORER: idf = log(N / df)
  SCORER -> SCORER: tfidf = tf * idf
  SCORER --> PIPE: tfidfScore
  deactivate SCORER
  
  PIPE -> STORE: getDocumentMetadata(docId)
  
  PIPE -> BOOST: boostByMetadata(metadata, query)
  activate BOOST
  BOOST -> BOOST: langMatch = (docLang == queryLang) ? 1.1 : 1.0
  BOOST -> BOOST: starBoost = 1 + (stars / 1000)
  BOOST -> BOOST: topicBoost = 1.05 ^ matchedTopics
  BOOST -> BOOST: metadataScore = langMatch * starBoost * topicBoost
  BOOST --> PIPE: metadataScore
  deactivate BOOST
  
  PIPE -> PIPE: finalScore = 0.75 * tfidf + 0.25 * metadata
end

PIPE -> RANK: rankResults(scoredDocs)
activate RANK
RANK -> RANK: sortByScore(descending)
RANK -> RANK: applyFilters(results, options)
RANK -> RANK: limitResults(topK=10)
RANK --> PIPE: rankedResults
deactivate RANK

PIPE -> FMT: formatResults(rankedResults)
activate FMT
FMT -> FMT: createResultObjects()
FMT -> FMT: formatForCLI()
FMT --> PIPE: formattedDisplay
deactivate FMT

PIPE --> CLI: results
deactivate PIPE

CLI --> USER: Display results:\n1. repo1/project1 (score: 0.95)\n2. repo2/project2 (score: 0.87)\n...

note over SCORER
  TF-IDF Score:
  term "javascript" appears 5 times
  doc has 100 words
  TF = 5/100 = 0.05
  IDF = log(1000/50) = 1.301
  TF-IDF = 0.0651
end note

note over BOOST
  Metadata Boost:
  Language match: 1.1x
  Stars (100): 1.1x
  Topics (2): 1.05² = 1.1025x
  Total boost: 1.336x
end note

note over RANK
  Final Score:
  0.75 × 0.0651 + 0.25 × 1.336
  = 0.0488 + 0.334 = 0.3828
end note

@enduml
